{"nodes": [{"id": "docs_design_grill_redesign_doc", "label": "Redise\u00f1o de F1Sim \u2014 entrevista y decisiones", "file_type": "document", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_grill_redesign_circuito_protagonista", "label": "Circuito protagonista y muro con espacio reservado", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coche seguido y SC deben verse con el muro abierto; el muro ocupa espacio reservado en lugar de flotar sobre el Canvas."}, {"id": "docs_design_grill_redesign_consulta_rival_separada", "label": "Consultar un rival no cambia el destinatario de \u00f3rdenes", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seguimiento de c\u00e1mara y \u00f3rdenes del equipo son contextos separados para evitar enviar BOX/ritmo al coche equivocado."}, {"id": "docs_design_grill_redesign_clasificacion_compacta", "label": "Clasificaci\u00f3n compacta de 20 pilotos", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_grill_redesign_detalle_sustituye_clasificacion", "label": "Detalle sustituye a la clasificaci\u00f3n en pantallas estrechas", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evita un tercer panel permanente; incluye regreso expl\u00edcito."}, {"id": "docs_design_grill_redesign_continuidad_consulta", "label": "Continuidad de consulta durante la carrera", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cerrar/reabrir conserva coche, pesta\u00f1a y selecciones; abrir/cerrar no pausa ni cambia velocidad; carrera nueva vuelve a la vista esencial."}, {"id": "docs_design_grill_redesign_rueda_fondo", "label": "Rueda 3D grande al fondo de la portada", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M\u00e1s fuerza visual pero menos protagonismo; capa frontal transl\u00facida sin transparentar el texto."}, {"id": "docs_design_grill_redesign_navegacion_portada", "label": "Navegaci\u00f3n de portada solo por bot\u00f3n y atajos", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se retira la entrada por clic en rueda o fondo para evitar navegaci\u00f3n accidental."}, {"id": "docs_design_grill_redesign_identidad_grafito_marfil_rojo", "label": "Identidad visual grafito, marfil y rojo de acci\u00f3n", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mayor contraste; colores sem\u00e1nticos de equipos, neum\u00e1ticos y banderas se conservan; sin part\u00edculas ni resplandores decorativos."}, {"id": "docs_design_grill_redesign_jerarquia_avisos", "label": "Jerarqu\u00eda de avisos de carrera", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barra estable con vuelta/estado/bandera/pausa; avisos breves sin robar foco ni desplazar controles; D20 conserva tiempos."}, {"id": "docs_design_grill_redesign_herramientas_desarrollo", "label": "Men\u00fa \u00abHerramientas de desarrollo\u00bb (SC y bandera roja)", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conservar los botones de prueba pero fuera de la vista principal; abrir el men\u00fa no ejecuta pruebas."}, {"id": "docs_design_grill_redesign_asistencia_discreta", "label": "Asistencia discreta basada en datos reales", "file_type": "rationale", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No inventar predicciones; el radar procedural no es previsi\u00f3n meteorol\u00f3gica real."}, {"id": "docs_design_grill_redesign_radar_procedural", "label": "Radar procedural de RightStatsPanel", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_grill_redesign_grillme", "label": "Entrevista GrillMe (cuatro rondas)", "file_type": "concept", "source_file": "docs/design/grill-redesign.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_design_grill_redesign_doc", "target": "docs_design_grill_redesign_circuito_protagonista", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/design/grill-redesign.md", "source_location": null, "weight": 1}, {"source": "docs_design_grill_redesign_doc", "target": "docs_design_grill_redesign_consulta_rival_separada", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/design/grill-redesign.md", "source_location": null, "weight": 1}, {"source": "docs_design_grill_redesign_do