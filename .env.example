# Copia este archivo como .env.local (git lo ignora) y pon la clave web de Firebase.
# Al publicar, la clave sale del secreto VITE_FIREBASE_API_KEY de GitHub Actions.
# Guía: docs/multijugador.md, «Clave de Firebase».
VITE_FIREBASE_API_KEY=

# Opcionales: identificadores del proyecto (por defecto, los de f1sim-d5085).
# VITE_FIREBASE_AUTH_DOMAIN=f1sim-d5085.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://f1sim-d5085-default-rtdb.europe-west1.firebasedatabase.app
# VITE_FIREBASE_PROJECT_ID=f1sim-d5085
# VITE_FIREBASE_APP_ID=1:539442261148:web:dfe2b053fdacad3c705159
