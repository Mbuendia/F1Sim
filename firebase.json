{
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "database": { "host": "127.0.0.1", "port": 9000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "landing/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/models/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/circuits/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/audio/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/racecars2d/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
      { "source": "/flags/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
    ]
  }
}
